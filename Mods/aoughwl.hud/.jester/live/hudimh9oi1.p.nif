      (ret result@7))))
   (for@4,2
    (call@E entries~7
     (call@6 named~5 RecipeSources@1))
    (unpackflat
     (let row . . ..))
    (stmts~2,1
     (if
      (elif@3
       (infix@9 ==
        (dot~6 row~3 text@1)"recipes"@3)
       (stmts@N
        (asgn@7 result~7
         (infix@9 \2B result~7 1@2))))))))))