ercent;hi=100;default=100;effect=busVolume\28"~6,r "page=sound;key=soundCategory.ambient;store=soundCategory_ambient;kind=slider;style=percent;hi=100;default=100;effect=busVolume\28"~6,s "page=sound;key=options.showSubtitles;store=showSubtitles;style=switch;reason=nothing in this modpack produces a subtitle"~6,t "page=chat;key=options.chat.visibility;store=chatVisibility;style=named;hi=2;reason=aoughwl.chat serves no settings - it would need a chat.settings service with a visibility line on it"~6,w "page=chat;key=options.chat.color;store=chatColors;style=switch;default=1;reason=the same service, with a colour line on it"~6,x "page=chat;key=options.chat.links;store=chatLinks;style=switch;default=1;reason=nothing in the chat window makes a link out of a url"~6,y "page=chat;key=options.chat.links.prompt;store=chatLinksPrompt;style=switch;default=1;reason=there are no links to prompt about"~6,z "page=chat;key=options.chat.opacity;store=chatOpacity;kind=slider;style=percent;hi=100;default=100;reason=the same service, with an opacity line on it"~6,10 "page=chat;key=options.chat.scale;store=chatScale;kind=slider;style=percent;hi=100;default=100;reason=the same service, with a scale line on it"~6,11 "page=chat;key=options.chat.width;store=chatWidth;kind=slider;style=percent;hi=100;default=100;reason=the same service, with a width line on it"~6,12 "page=chat;key=options.chat.height.focused;store=chatHeightFocused;kind=slider;style=percent;hi=100;default=100;reason=the same service, with a height line on it"~6,13 "page=chat;key=options.chat.height.unfocused;store=chatHeightUnfocused;kind=slider;style=percent;hi=100;default=44;reason=the same service, with a height line on it"~6,14 "page=chat;key=options.chat.line_spacing;store=chatLineSpacing;kind=slider;style=percent;hi=100;reason=the same service, with a line-spacing line on it"~6,15 "page=chat;key=options.chat.delay_instant;store=chatDelay;kind=slider;hi=60;reason=nothing delays a chat line"~6,16 "page=chat;key=options.autoSuggestCommands;store=autoSuggestCommands;style=switch;default=1;reason=there are no commands to suggest"~6,17 "page=chat;key=options.hideMatchedNames;store=hideMatchedNames;style=switch;default=1;reason=there is no ignore list to match a name against"~6,18 "page=skin;key=options.modelPart.cape;store=modelPart_cape;style=switch;default=1;reason=the player model in aoughwl.voxel is six boxes and has no cape"~6,1B "page=skin;key=options.modelPart.jacket;store=modelPart_jacket;style=switch;default=1;reason=the player model has no outer layer to hide"~6,1C "page=skin;key=options.modelPart.left_sleeve;store=modelPart_left_sleeve;style=switch;default=1;reason=the player model has no outer layer to hide"~6,1D "page=skin;key=options.modelPart.right_sleeve;store=modelPart_right_sleeve;style=switch;default=1;reason=the player model has no outer layer to hide"~6,1E "page=skin;key=options.modelPart.left_pants_leg;store=modelPart_left_pants_leg;style=switch;default=1;reason=the player model has no outer layer to hide"~6,1F "page=skin;key=options.modelPart.right_pants_leg;store=modelPart_right_pants_leg;style=switch;default=1;reason=the player model has no outer layer to hide"~6,1G "page=skin;key=options.modelPart.hat;store=modelPart_hat;style=switch;default=1;reason=the head\27s second layer is drawn unconditionally in vxskin"~6,1H "page=skin;key=options.mainHand;store=mainHand;style=named;hi=1;default=1;reason=the hand in the corner of the screen is drawn on one side only"~6,1I "page=access;key=options.accessibility.text_background_opacity;store=textBackgroundOpacity;kind=slider;style=percent;hi=100;default=50;reason=nothing draws a background behind text"~6,1L "page=access;key=options.chat.line_spacing;store=chatLineSpacing;kind=slider;style=percent;hi=100;reason=aoughwl.chat serves no settings"~6,1M "page=access;key=options.chat.delay_instant;store=chatDelay;kind=slider;hi=60;reason=nothing delays a chat line"~6,1N "page=access;key=options.autoJump;store=autoJump;style=switch;effect=world\3AautoJump"~6,1O "page=access;key=options.showSubtitles;store=showSubtitles;style=switch;reason=nothing produces a subtitle"~6,1P "page=access;key=options.accessibility.toggle_sprint;store=toggleSprint;style=switch;reason=sprint is held rather than toggled inside the character, and ModSdk bindKey has no say over which"~6,1Q "page=access;key=options.accessibility.toggle_crouch;store=toggleCrouch;style=switch;reason=there is no crouch in this world, so there is nothing to hold down or to toggle"~6,1R "page=access;key=options.darkMojangStudiosBackgroundColor;store=darkMojangStudiosBackground;style=switch;reason=the studio screen is drawn from the granted copy\27s own picture"~6,1S "page=access;key=options.hideLightningFlashes;store=hideLightningFlashes;style=switch;reason=there is no weather in this world, and therefore no lightning to flash"~6,1T "page=access;key=options.monochromeLogo;store=monochromeLogo;style=switch;reason=the logo is the granted copy\27s own picture and has one colouring"~6,1U "page=access;key=options.screenEffectScale;store=screenEffectScale;kind=slider;style=percent;hi=100;default=100;reason=no post-processing is reachable"~6,1V "page=access;key=options.fovEffectScale;store=fovEffectScale;kind=slider;style=percent;hi=100;default=100;reason=nothing modulates the field of view per frame"~6,1W))
