ncCount"~6,J "page=video;key=options.fullscreen;store=fullscreen;style=switch;effect=displayMode\28"~6,K "page=video;key=options.gamma;store=gamma;kind=slider;hi=100;default=50;style=percent;min=options.gamma.min;max=options.gamma.max;reason=no host call sets RenderSettings.ambientLight, and docs/SKY.md specifies the sky_ calls that would carry it"~6,L "page=video;key=options.ao;store=ao;style=switch;default=1;reason=the mesh host takes no vertex colours, so smooth lighting cannot be baked into a chunk"~6,M "page=video;key=options.viewBobbing;store=bobView;style=switch;default=1;effect=world\3AviewBobbing"~6,N "page=video;key=options.renderClouds;store=renderClouds;style=switch;default=1;reason=nothing in this modpack draws clouds"~6,O "page=video;key=options.particles;store=particles;style=named;hi=2;reason=nothing in this modpack spawns a particle"~6,P "page=video;key=options.mipmapLevels;store=mipmapLevels;kind=slider;hi=4;default=4;reason=no host call sets a texture\27s mipmap count"~6,Q "page=video;key=options.entityShadows;store=entityShadows;style=switch;default=1;reason=no host call turns one renderer\27s shadows off"~6,R "page=video;key=options.biomeBlendRadius;store=biomeBlendRadius;kind=slider;hi=7;default=2;reason=the generator has one biome, so there is nothing to blend between"~6,S "page=video;key=options.entityDistanceScaling;store=entityDistanceScaling;kind=slider;style=percent;lo=50;hi=500;step=25;default=100;reason=no host call sets a renderer\27s cull distance"~6,T "page=video;key=options.attackIndicator;store=attackIndicator;style=named;hi=2;default=1;reason=nothing draws an attack cooldown"~6,U "page=video;key=options.screenEffectScale;store=screenEffectScale;kind=slider;style=percent;hi=100;default=100;reason=no post-processing is reachable\3A no RenderTexture, no command buffers, no Graphics calls"~6,V "page=video;key=options.fovEffectScale;store=fovEffectScale;kind=slider;style=percent;hi=100;default=100;reason=the field of view is set once a