(.nif27)
(.vendor "Nifler")
(.dialect "nim-parsed")
(stmts@,1,mcplan.nim
 (comment)
 (const@D,S RoleNothing~B x . . 0@4)
 (const@D,U RoleListing~B x . . 1@4)
 (const@H,W RoleBlockModels~F x . . 2@4)
 (const@H,X RoleBlockstates~F x . . 3@4)
 (const@G,Y RoleItemModels~E x . . 4@4)
 (const@L,Z RoleItemDefinitions~J x . . 5@4)
 (const@A,c RoleMeta~8 x . . 6@4)
 (const@D,d RoleRecipes~B x . . 7@4)
 (const@B,e RoleFiles~9 x . . 8@4)
 (comment@,i)
 (proc@,k finishedStep@5 x . .
  (params@I
   (param@1 cursor . . int@8 .))int@F . .
  (stmts@d
   (infix@7 \2D cursor~7 1@2)))
 (comment@,m)
 (proc@,q jarRole@5 x . .
  (params@D
   (param@1 finished . . int@A .))int@H . .
  (stmts@2,1
   (if
    (elif@3
     (infix@9 < finished~9 0@2)
     (stmts@E RoleNothing))
    (elif@5,1
     (infix@9 == finished~9 0@3)
     (stmts@F RoleListing))
    (elif@5,2
     (infix@9 == finished~9 1@3)
     (stmts@F RoleBlockModels))
    (elif@5,3
     (infix@9 == finished~9 3@3)
     (stmts@F RoleBlockstates))
    (elif@5,4
     (infix@9 == finished~9 4@3)
     (stmts@F RoleItemModels))
    (elif@5,5
     (infix@9 == finished~9 6@3)
     (stmts@F RoleMeta))
    (elif@5,6
     (infix@9 == finished~9 7@3)
     (stmts@F RoleRecipes))
    (elif@5,7
     (infix@9 == finished~9 8@3)
     (stmts@F RoleItemDefinitions))
    (else@,8
     (stmts@6 RoleFiles)))))
 (comment@,11)
 (proc@,14 packRole@5 x . .
  (params@E
   (param@1 finished . . int@A .))int@H . .
  (stmts@2,1
   (if
    (elif@3
     (infix@9 < finished~9 0@2)
     (stmts@E RoleNothing))
    (else@T
     (stmts@6 RoleFiles))))))