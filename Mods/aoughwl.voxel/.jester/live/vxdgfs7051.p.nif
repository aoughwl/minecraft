(.nif27)
(.vendor "Nifler")
(.dialect "nim-parsed")
(stmts@,1,vxdefaults.nim
 (comment)
 (const@B,E AtlasFile~9 x . . "Textures/blocks.png"@4)
 (const@E,F AtlasColumns~C x . . 13@4)
 (const@B,G AtlasSide~9 x . . 16@4)
 (comment@,Q)
 (proc@,R defaultNames@5 x . .
  (params@I)
  (at@7 seq~3 string@1). .
  (stmts@2,1
   (prefix \40
    (bracket@1 "bedrock"@1 "stone"@C "cobblestone"@L "dirt"@a "grass"@i "sand"@r "water"@z "wood"@1,1 "leaves"@9,1 "brick"@J,1 "glowstone"@S,1))))
 (comment@,V)
 (proc@,W defaultSpecs@5 x . .
  (params@I)
  (at@7 seq~3 string@1). .
  (stmts@2,1
   (prefix \40
    (bracket@1 "label=Bedrock;hardness=-1;colour=\232f2f33"@1,1 "label=Stone;hardness=1.5;colour=\237d7d80;drops=cobblestone"@1,2 "label=Cobblestone;hardness=2.0;colour=\238a8a8d"@1,3 "label=Dirt;hardness=0.5;colour=\238b5a2b"@1,4 "label=Grass;hardness=0.6;colour=\235d9b42;drops=dirt"@1,5 "label=Sand;hardness=0.5;colour=\23ddd0a0"@1,6 "label=Water;hardness=-1;liquid=true;colour=\233a6fd0"@1,7 "label=Wood;hardness=1.0;colour=\236b4a2a"@1,8 "label=Leaves;hardness=0.2;colour=\233f7d33"@1,9 "label=Brick;hardness=1.8;colour=\23a8503c"@1,A "label=Glowstone;hardness=0.3;colour=\23f0d47a"@1,B))))
 (comment@,k)
 (proc@,11 defaultPictures@5 x . .
  (params@L)
  (at@7 seq~3 string@1). .
  (stmts@2,1
   (prefix \40
    (bracket@1 "Textures/blocks/bedrock.png"@1,1 "Textures/blocks/stone.png"@1,2 "Textures/blocks/cobblestone.png"@1,3 "Textures/blocks/dirt.png"@1,4
     (infix@z,8 &
      (infix@5,~1 & "Textures/blocks/grass_side.png|Textures/blocks/grass_side.png|"~13 "Textures/blocks/grass_top.png|Textures/blocks/dirt.png|"~11,1)"Textures/blocks/grass_side.png|Textures/blocks/grass_side.png"~w,1)"Textures/blocks/sand.png"@1,A "Textures/blocks/water.png"@1,B
     (infix@12,D &
      (infix@,~1 & "Textures/blocks/wood_side.png|Textures/blocks/wood_side.png|"~11 "Textures/blocks/wood_top.png|Textures/blocks/wood_top.png|"~z,1)"Textures/blocks/wood_side.png|Textures/blocks/wood_side.png"~z,1)"Textures/blocks/leaves.png"@1,F "Textures/blocks/brick.png"@1,G "Textures/blocks/glowstone.png"@1,H))))
 (comment@,1L)
 (proc@,1T defaultTiles@5 x . .
  (params@I)
  (at@7 seq~3 string@1). .
  (stmts@2,1
   (prefix \40
    (bracket@1 "13x16|11"@1,1 "13x16|0"@1,2 "13x16|1"@1,3 "13x16|2"@1,4 "13x16|4,4,3,2,4,4"@1,5 "13x16|5"@1,6 "13x16|12"@1,7 "13x16|7,7,6,6,7,7"@1,8 "13x16|8"@1,9 "13x16|9"@1,A "13x16|10"@1,B)))))